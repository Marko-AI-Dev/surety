# Shared by the API, scripts and the signer client. Never put seeds here.
SIGNER_URL=http://127.0.0.1:4100
SIGNER_HMAC_SECRET=
GATE_AUTH_SECRET=
SELLER_ADDRESS=
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233/
OPENROUTER_API_KEY=
# Local Supabase (supabase start, ports 577xx). Backend connects as postgres.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:57722/postgres
# Worker: how often to run a pass (evaluate delivered jobs, settle approved ones, refund expired ones).
SWEEP_INTERVAL_MS=5000
# Judge for delivered work: live (Jev via OpenRouter, needs OPENROUTER_API_KEY) or fixture (scripted
# demo scores, labelled as such, never presented as live Jev). Default live.
JEV_MODE=live
# TESTUSD and operator limits. These do NOT go in this file: the one-time setup
# (pnpm --filter @surety/signer setup-testusd) writes them to services/signer/.env.testusd
# (TESTUSD_ISSUER, APPROVED_SUPPLIERS, MAX_DEAL_TESTUSD_CENTS, DAILY_TESTUSD_CENTS,
# MAX_OPEN_TESTUSD_DEALS, OPERATOR_HMAC_SECRET), services/signer/.env.issuer (issuer key) and
# .env.operator (OPERATOR_HMAC_SECRET for operator tools only, never for the worker or agents).
# The caps there are only the starting policy; the operator changes them live. Amounts are cents.
# On Windows the owner-only file mode the setup asks for is not enforced; keep these files private.
