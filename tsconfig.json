{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "services/*/src",
    "services/*/test",
    "services/*/scripts",
    "scripts",
    "tests",
    "vitest.config.ts",
    "vitest.db.config.ts"
  ]
}
