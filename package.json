{
  "name": "surety",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "signer": "pnpm --filter @surety/signer start",
    "worker": "pnpm --filter @surety/worker start",
    "spike": "tsx --env-file=.env scripts/spike-escrow.ts",
    "demo:restart": "node --env-file=.env --import tsx scripts/restart-refund-demo.ts",
    "demo:outcomes": "node --env-file=.env --import tsx scripts/outcomes-demo.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:start": "supabase start -x studio,imgproxy,analytics,vector,edge-runtime,storage",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "spike:testusd": "node --env-file=.env --env-file=.env.operator --import tsx scripts/spike-testusd-signer.ts",
    "demo:deals": "node --env-file=.env --import tsx scripts/deals-demo.ts",
    "fixtures:deals":"tsx scripts/deal-fixtures.ts",
    "limits:set":"node --env-file=.env --env-file=.env.operator --import tsx scripts/set-limits.ts",
    "probe:paperclip": "tsx scripts/paperclip-probe.ts",
    "fixtures:chat": "tsx scripts/chat-fixtures.ts",
    "api": "pnpm --filter @surety/api start",
    "api:tokens": "tsx services/api/scripts/make-tokens.ts",
    "suppliers": "pnpm --filter @surety/supplier-agents start",
    "suppliers:directory": "node --env-file=.env --import tsx scripts/supplier-directory.ts",
    "supplier:clear": "node --env-file=.env --import tsx scripts/clear-supplier.ts",
    "paperclip:team": "tsx scripts/paperclip-team.ts",
    "sourcing:status": "node --env-file=.env --import tsx scripts/sourcing-status.ts",
    "evidence:sourcing": "node --env-file=.env --env-file=.env.api --import tsx scripts/sourcing-evidence.ts"
  },
  "devDependencies": {
    "@surety/contracts": "workspace:*",
    "@surety/gate": "workspace:*",
    "@surety/signer-client": "workspace:*",
    "@surety/workflow": "workspace:*",
    "@surety/xrpl-settlement": "workspace:*",
    "@types/node": "24.19.2",
    "postgres": "4.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "xrpl": "5.3.0"
  }
}
