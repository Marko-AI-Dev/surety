{
  "name": "surety",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "signer": "pnpm --filter @surety/signer start",
    "worker": "pnpm --filter @surety/worker start",
    "spike": "tsx --env-file=.env scripts/spike-escrow.ts",
    "demo:restart": "node --env-file=.env --import tsx scripts/restart-refund-demo.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:start": "supabase start -x studio,imgproxy,analytics,vector,edge-runtime,storage",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "@surety/contracts": "workspace:*",
    "@surety/signer-client": "workspace:*",
    "@surety/workflow": "workspace:*",
    "@surety/xrpl-settlement": "workspace:*",
    "@types/node": "24.19.2",
    "postgres": "4.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "xrpl": "5.3.0"
  }
}
